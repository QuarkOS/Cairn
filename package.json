{
  "name": "@quarkos/cairn",
  "version": "0.4.2",
  "description": "Typed facts that outlive the session. Agents assert, recall, and retract through JSON or MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cairn": "./bin/cairn.mjs"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "templates",
    "public",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "components.json",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuarkOS/Cairn.git"
  },
  "homepage": "https://github.com/QuarkOS/Cairn#readme",
  "bugs": {
    "url": "https://github.com/QuarkOS/Cairn/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cairn",
    "mcp",
    "agent",
    "facts",
    "sqlite",
    "quarkos"
  ],
  "scripts": {
    "dev": "node bin/cairn.mjs dev",
    "build": "next build",
    "start": "node bin/cairn.mjs start",
    "lint": "eslint",
    "test": "tsx --test src/lib/cairn/*.test.ts src/mcp/*.test.ts cli/*.test.ts",
    "cairn": "node bin/cairn.mjs",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.1"
  }
}
